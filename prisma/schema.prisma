// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DomainVerificationStatus {
  pending
  verified
  failed
}

enum EmailStatus {
  received
  forwarded
  failed
  pending
  invalid
}

enum AttachmentsStatus {
  not_processed
  processing
  completed
  failed
}

enum AliasMode {
  forward
  mailbox
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  passkeys        Passkey[]
  domains         Domain[]
  aliases         Alias[]
  emailLogs       EmailLog[]
  mailboxes       Mailbox[]
  mailboxSessions MailboxSession[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Domain {
  id                 String                   @id @default(cuid())
  userId             String
  domain             String? // Keep for migration compatibility
  rootDomain         String                   @default("")
  subdomain          String?
  fullDomain         String                   @default("")
  sesIdentityArn     String?
  verificationStatus DomainVerificationStatus @default(pending)
  dkimStatus         String?                  @default("pending")
  mxStatus           String?                  @default("pending")
  verificationError  String?
  dnsRecords         String?
  lastCheckedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases   Alias[]
  logs      EmailLog[]
  mailboxes Mailbox[]

  @@unique([userId, fullDomain])
  @@index([userId])
  @@map("domains")
}

model Alias {
  id        String    @id @default(cuid())
  userId    String
  domainId  String
  localPart String
  forwardTo String?
  mode      AliasMode @default(forward)
  mailboxId String?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain  Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  mailbox Mailbox?   @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  logs    EmailLog[]

  @@unique([domainId, localPart])
  @@index([userId])
  @@index([domainId])
  @@index([mailboxId])
  @@map("aliases")
}

model EmailLog {
  id       String  @id @default(cuid())
  userId   String
  domainId String
  aliasId  String?

  fromEmail     String
  toEmail       String
  subject       String?
  status        EmailStatus
  error         String?
  pendingReason String?

  s3Bucket String?
  s3Key    String? @unique
  size     Int?

  attachmentsStatus AttachmentsStatus @default(not_processed)
  attachmentsError  String?

  createdAt DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  alias       Alias?            @relation(fields: [aliasId], references: [id], onDelete: SetNull)
  attachments EmailAttachment[]

  @@index([userId])
  @@index([domainId])
  @@index([aliasId])
  @@index([s3Key])
  @@map("email_logs")
}

model Mailbox {
  id           String  @id @default(cuid())
  userId       String
  domainId     String
  emailAlias   String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain   Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  aliases  Alias[]
  sessions MailboxSession[]

  @@index([userId])
  @@index([domainId])
  @@map("mailboxes")
}

model MailboxSession {
  id        String    @id @default(cuid())
  mailboxId String
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mailboxId])
  @@index([userId])
  @@map("mailbox_sessions")
}

model EmailAttachment {
  id         String   @id @default(cuid())
  emailLogId String
  filename   String
  mimeType   String
  size       Int
  s3Bucket   String
  s3Key      String   @unique
  createdAt  DateTime @default(now())

  emailLog EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([emailLogId])
  @@map("email_attachments")
}
